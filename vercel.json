{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://apisoft.tiyan.my.id/:path*"
    },
    {
      "source": "/anichin/:path*",
      "destination": "https://anichin.moe/:path*"
    },
    {
      "source": "/(.*\\.mp4)",
      "has": [
        {
          "type": "query",
          "key": "url",
          "value": "(?<url>.*)"
        }
      ],
      "destination": "https://apisoft.tiyan.my.id/v1/p/legacy.mp4?url=:url"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
