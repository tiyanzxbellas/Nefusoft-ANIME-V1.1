{
  "rewrites":[
    {
      "source": "/api/:path*",
      "destination": "https://apisoft.tiyan.my.id/:path*"
    },
    {
      "source": "/(.*\\.mp4)",
      "has":[
        {
          "type": "query",
          "key": "url",
          "value": "(?<url>.*)"
        }
      ],
      "destination": "https://cf.tiyanstores.workers.dev/?url=:url"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}